{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-lightsout",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": ".",
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD",
      "id": "713bd23b6871426790469b9ee61d46e3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "f1-lightsout-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
